{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QAIA-Project/QAIA/docs/schemas/output-contract-v1.schema.json",
  "title": "QAIA run manifest (output contract 1.0)",
  "description": "Formal JSON Schema for docs/OUTPUT-CONTRACT.md, contract version 1.0. Validates .qaia/reports/<US-ID>/manifest.json. A consumer that needs a field a producer did not write must treat it as absent (degraded mode, shared contract rule 8) -- this schema keeps every section but 'contract'/'usId'/'title'/'status'/'generatedAt'/'base'/'producers'/'artifacts' optional to match that rule.",
  "type": "object",
  "required": [
    "contract",
    "usId",
    "title",
    "status",
    "generatedAt",
    "base",
    "producers",
    "artifacts"
  ],
  "additionalProperties": true,
  "properties": {
    "contract": {
      "type": "string",
      "description": "SemVer of this schema. A consumer checks the major version before reading.",
      "pattern": "^\\d+\\.\\d+$"
    },
    "usId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "validated"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "producers": {
      "type": "array",
      "description": "Provenance chain, append-only. Never drop another plugin's entry.",
      "items": {
        "type": "object",
        "required": [
          "plugin",
          "version",
          "skill",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "plugin": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "format",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "dataset",
              "dataset-map",
              "execution",
              "export",
              "feature",
              "flakiness",
              "matrix",
              "synthesis",
              "trafficReplay",
              "validation"
            ]
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "design": {
      "type": "object",
      "description": "Filled by qaia-core:report. Optional -- absent means not yet generated/reported.",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "coverage",
        "confidence",
        "techniques",
        "oracles",
        "knowledgeApplied"
      ],
      "properties": {
        "scenarios": {
          "type": "object",
          "required": [
            "total",
            "byPriority",
            "negative",
            "smoke",
            "outlines"
          ],
          "additionalProperties": false,
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "byPriority": {
              "type": "object",
              "required": [
                "P1",
                "P2",
                "P3"
              ],
              "additionalProperties": false,
              "properties": {
                "P1": {
                  "type": "integer",
                  "minimum": 0
                },
                "P2": {
                  "type": "integer",
                  "minimum": 0
                },
                "P3": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "negative": {
              "type": "integer",
              "minimum": 0
            },
            "smoke": {
              "type": "integer",
              "minimum": 0
            },
            "outlines": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "byLevel": {
          "type": "object",
          "description": "Contract 1.1 (ADR 0008) -- the test level decided at DESIGN time, closed keys, summing to design.scenarios.total. Optional so 1.0 manifests stay valid; when present it must be complete.",
          "required": [
            "e2e",
            "api"
          ],
          "additionalProperties": false,
          "properties": {
            "e2e": {
              "type": "integer",
              "minimum": 0
            },
            "api": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "coverage": {
          "type": "object",
          "description": "reqNegCovered/reqNegTotal is the ADR 0001 gate (blocking). negativeRatio (D20) is a reported signal, never a threshold.",
          "required": [
            "acTotal",
            "acCovered",
            "reqNegTotal",
            "reqNegCovered",
            "negativeRatio"
          ],
          "additionalProperties": false,
          "properties": {
            "acTotal": {
              "type": "integer",
              "minimum": 0
            },
            "acCovered": {
              "type": "integer",
              "minimum": 0
            },
            "reqNegTotal": {
              "type": "integer",
              "minimum": 0
            },
            "reqNegCovered": {
              "type": "integer",
              "minimum": 0
            },
            "negativeRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "confidence": {
          "type": "object",
          "required": [
            "lowConfidence",
            "openQuestions",
            "assumptions",
            "simulated"
          ],
          "additionalProperties": false,
          "properties": {
            "lowConfidence": {
              "type": "integer",
              "minimum": 0
            },
            "openQuestions": {
              "type": "integer",
              "minimum": 0
            },
            "assumptions": {
              "type": "integer",
              "minimum": 0
            },
            "simulated": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "techniques": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "oracles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowledgeApplied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Filled by qaia-playwright:run-report. Optional -- absent means no automated run yet.",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "blocked",
        "byType",
        "traceability"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "byType": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "traceability": {
          "type": "object",
          "required": [
            "scenariosAutomated",
            "scenariosTotal"
          ],
          "additionalProperties": false,
          "properties": {
            "scenariosAutomated": {
              "type": "integer",
              "minimum": 0
            },
            "scenariosTotal": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "openArbitrations": {
      "type": "array",
      "description": "Mirrors every pending checkpoint decision, including every 'simulated' entry from non-interactive runs.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "about",
          "sourceCheckpoint"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "assumption",
              "open",
              "simulated"
            ]
          },
          "about": {
            "type": "string",
            "minLength": 1
          },
          "sourceCheckpoint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "description": "Written ONLY by a qaia-score skill (shared contract rule 3: no producer self-scores). Absence means 'not yet scored'. A PARTIAL gate is valid: `score`/`dimensions` may be present without `verdict` -- see validate_manifest.py, which allows it and is the authority. When `verdict` IS written, `reasons` and `waiver` become mandatory; JSON Schema cannot express that conditional, so the Python validator remains the arbiter.",
      "additionalProperties": false,
      "required": [
        "score",
        "max",
        "scoredBy",
        "at",
        "dimensions"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "CONCERNS",
            "FAIL",
            "WAIVED"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "scoredBy": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "dimensions": {
          "type": "array",
          "description": "Only non-2 (non-max) dimensions are listed.",
          "items": {
            "type": "object",
            "required": [
              "n",
              "name",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "waiver": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "by",
            "reason",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "structural": {
      "type": "object",
      "description": "The deterministic /100 pass, kept SEPARATE from `gate` on purpose: the founding case measured one book 100/100 by machine and 58/100 by a human, so the two numbers answer different questions and are never merged. Absent from this schema until 2026-08-08 -- an architecture review found the omission, and it is the most binding gate of the product.",
      "additionalProperties": false,
      "required": [
        "at",
        "forcedStop",
        "gate",
        "max",
        "score",
        "scoredBy"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "const": 100,
          "description": "Fixed budget: 25+30+20+25."
        },
        "gate": {
          "type": "string",
          "enum": [
            "CONCERNS",
            "FAIL",
            "PASS"
          ]
        },
        "forcedStop": {
          "type": "boolean"
        },
        "scoredBy": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
